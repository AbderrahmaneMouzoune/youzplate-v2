# URL publique de la boutique, sans slash final. Lue au build (NEXT_PUBLIC_).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Indexation : uniquement en production, mettre exactement `true`.
IS_INDEXABLE=

# Stripe — dashboard.stripe.com → Developers → API keys / Webhooks.
# En local : `stripe listen --forward-to localhost:3000/api/stripe/webhook` donne le whsec_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Notification de commande à l'équipe (optionnel : sans Resend, la commande est loguée).
RESEND_API_KEY=
ORDER_EMAIL_FROM="Youzplate <commandes@youzoune.com>"
ORDER_EMAIL_TO=contact@youzoune.com
