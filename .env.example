# URL publique de la boutique, sans slash final. Lue au build (NEXT_PUBLIC_).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Indexation : uniquement en production, mettre exactement `true`.
IS_INDEXABLE=

# Stripe — dashboard.stripe.com → Developers → API keys / Webhooks.
# En local : `stripe listen --forward-to localhost:3000/api/stripe/webhook` donne le whsec_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Notification de commande à l'équipe (optionnel : sans Resend, la commande est loguée).
RESEND_API_KEY=
ORDER_EMAIL_FROM="Youzplate <commandes@youzoune.com>"
ORDER_EMAIL_TO=contact@youzoune.com

# PostHog (mesure d'audience, Error tracking) — eu.posthog.com → Project settings → Project token.
# Clé publique `phc_…`, faite pour le navigateur. Optionnelle : sans elle, aucune mesure.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Hôte d'ingestion pour les événements serveur (défaut : https://eu.i.posthog.com).
NEXT_PUBLIC_POSTHOG_HOST=
# Source maps → PostHog Error tracking, au build (Vercel uniquement, secret).
# eu.posthog.com → Settings → Personal API keys, scopes « Error tracking: Write » + « Organization: Read ».
# Sans elle, le build ignore l'envoi. Une clé invalide fait échouer le build.
POSTHOG_PERSONAL_API_KEY=
# Projet Youzplate (défaut : 317737).
POSTHOG_PROJECT_ID=
